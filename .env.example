NODE_ENV=development
PORT=4000
HOST=127.0.0.1
DB_URI=mongodb://127.0.0.1:27017/cocktail_portfolio?replicaSet=rs0
SESSION_SECRET=replace-with-at-least-32-random-characters
# Required in production; protects all write operations with HTTP Basic authentication.
ADMIN_PASSWORD=
# Set to 1 only behind one trusted reverse proxy using HTTPS.
TRUST_PROXY=0
