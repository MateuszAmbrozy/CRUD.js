<%- include('layout/header') %>
<div class="form-page">
  <a href="/cocktails/<%= cocktailId %>/ingredients">← Recipe</a>
  <h1>Edit ingredient</h1>
  <form
    method="post"
    action="/update/ingredient/<%= ingredient._id %>?csrf=<%= csrfToken %>"
    enctype="multipart/form-data"
  >
    <input type="hidden" name="cocktailId" value="<%= cocktailId %>" />
    <label for="name">Name</label>
    <input id="name" name="name" maxlength="100" value="<%= ingredient.name %>" required />
    <label for="description">Description</label>
    <textarea id="description" name="description" maxlength="1000" required><%= ingredient.description %></textarea>
    <label for="quantity">Quantity, including unit</label>
    <input id="quantity" name="quantity" maxlength="100" value="<%= quantity %>" required />
    <label for="isAlcohol">Contains alcohol?</label>
    <select id="isAlcohol" name="isAlcohol">
      <option value="false" <%= !ingredient.isAlcohol ? 'selected' : '' %>>No</option>
      <option value="true" <%= ingredient.isAlcohol ? 'selected' : '' %>>Yes</option>
    </select>
    <% if(ingredient.image) { %>
    <img class="thumbnail" src="/uploads/<%= encodeURIComponent(ingredient.image) %>" alt="<%= ingredient.name %>" />
    <% } %>
    <label for="image">Replace photo (optional)</label>
    <input id="image" type="file" name="image" accept="image/png,image/jpeg,image/webp" />
    <p class="muted">PNG, JPEG or WebP, up to 2 MB. Leave empty to keep the current photo.</p>
    <div class="actions">
      <button type="submit">Save changes</button>
      <a href="/cocktails/<%= cocktailId %>/ingredients">Cancel</a>
    </div>
  </form>
</div>
<%- include('layout/footer') %>
