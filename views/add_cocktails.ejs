<%- include('layout/header') %>
<div class="form-page">
  <a href="/">← Collection</a>
  <p class="eyebrow">MAKE SOMETHING MEMORABLE</p>
  <h1>Add a cocktail</h1>
  <form method="post" action="/add?csrf=<%= csrfToken %>" enctype="multipart/form-data">
    <label for="name">Name</label>
    <input id="name" name="name" maxlength="100" value="<%= '' %>" required />
    <label for="category">Category</label>
    <input id="category" name="category" maxlength="60" value="<%= '' %>" required />
    <label for="instruction">Instructions</label>
    <textarea id="instruction" name="instruction" maxlength="5000" required><%= '' %></textarea>
    <h2>Ingredients</h2>
    <div id="ingredients-section">
      <fieldset class="ingredient">
        <legend>Ingredient</legend>
        <label for="ingredient-0-name">Name</label>
        <input id="ingredient-0-name" name="ingredients[0][name]" maxlength="100" required />
        <label for="ingredient-0-description">Description</label>
        <input
          id="ingredient-0-description"
          name="ingredients[0][description]"
          maxlength="1000"
          required
        />
        <label for="ingredient-0-isAlcohol">Contains alcohol?</label>
        <select id="ingredient-0-isAlcohol" name="ingredients[0][isAlcohol]">
          <option value="false">No</option>
          <option value="true">Yes</option>
        </select>
        <label for="ingredient-0-quantity">Quantity, including unit</label>
        <input
          id="ingredient-0-quantity"
          name="ingredients[0][quantity]"
          maxlength="100"
          placeholder="e.g. 45 ml or 2 slices"
          required
        />
        <label for="ingredient-0-image">Photo (optional)</label>
        <input
          id="ingredient-0-image"
          type="file"
          name="ingredients[0][image]"
          accept="image/png,image/jpeg,image/webp"
        />
        <p class="muted">PNG, JPEG or WebP, up to 2 MB.</p>
      </fieldset>
    </div>
    <button type="button" id="add-ingredient-btn" class="secondary">+ Add ingredient</button>
    <p id="ingredient-count" class="muted" aria-live="polite">1 of 20 ingredients</p>
    <div class="actions">
      <button type="submit">Save recipe</button>
      <a href="/">Cancel</a>
    </div>
  </form>
</div>
<%- include('layout/footer') %>
