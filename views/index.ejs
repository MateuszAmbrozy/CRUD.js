<%- include('layout/header') %>
<section class="hero">
  <p class="eyebrow">THE RECIPE COLLECTION</p>
  <h1>
    A good drink starts
    <br />
    with a good recipe.
  </h1>
  <p>Keep your favourite cocktails, ingredients and techniques in one place.</p>
  <a class="button" href="/add">Add a cocktail ↗</a>
</section>
<section>
  <div class="section-heading">
    <h2>
      Your collection
      <small>(<%= total %>)</small>
    </h2>
    <form class="search" method="get" action="/">
      <label class="sr-only" for="q">Search cocktails by name</label>
      <input id="q" name="q" maxlength="100" value="<%= q %>" placeholder="Search recipes…" />
      <button type="submit">Search</button>
      <% if(q) { %>
      <a href="/">Clear</a>
      <% } %>
    </form>
  </div>
  <% if (!cocktails.length) { %>
  <div class="empty">
    <h3><%= q ? 'No matching recipes' : 'Your first recipe belongs here' %></h3>
    <p><%= q ? 'Try a different name.' : 'Add a cocktail and start building your collection.' %></p>
    <a href="/add">Create a recipe →</a>
  </div>
  <% } %>
  <div class="cards">
    <% cocktails.forEach((cocktail) => { %>
    <article class="recipe">
      <p class="eyebrow"><%= cocktail.category %></p>
      <h3><a href="/cocktails/<%= cocktail._id %>/ingredients"><%= cocktail.name %></a></h3>
      <p class="instructions"><%= cocktail.instruction %></p>
      <p class="muted"><%= cocktail.ingredients.length %> ingredients</p>
      <div class="actions">
        <a href="/cocktails/<%= cocktail._id %>/ingredients">View recipe →</a>
        <a href="/cocktails/<%= cocktail._id %>/edit">
          Edit
          <span class="sr-only"><%= cocktail.name %></span>
        </a>
        <form
          method="post"
          action="/cocktails/<%= cocktail._id %>/delete?csrf=<%= csrfToken %>"
          data-confirm="Delete this cocktail and its ingredients?"
        >
          <button class="danger" type="submit">
            Delete
            <span class="sr-only"><%= cocktail.name %></span>
          </button>
        </form>
      </div>
    </article>
    <% }) %>
  </div>
  <% if(pages > 1) { %>
  <nav class="pagination" aria-label="Pagination">
    <% if(page > 1) { %>
    <a href="/?page=<%= page - 1 %>&q=<%= encodeURIComponent(q) %>">← Previous</a>
    <% } %>
    <span>Page <%= page %> of <%= pages %></span>
    <% if(page < pages) { %>
    <a href="/?page=<%= page + 1 %>&q=<%= encodeURIComponent(q) %>">Next →</a>
    <% } %>
  </nav>
  <% } %>
</section>
<%- include('layout/footer') %>
