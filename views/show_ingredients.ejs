<%- include('layout/header') %>
<a href="/">← Collection</a>
<section class="recipe-heading">
  <p class="eyebrow"><%= cocktail.category %></p>
  <h1><%= cocktail.name %></h1>
  <h2>Method</h2>
  <p class="method"><%= cocktail.instruction %></p>
  <a href="/cocktails/<%= cocktail._id %>/edit">Edit recipe →</a>
</section>
<h2>Ingredients</h2>
<div class="cards">
  <% cocktail.ingredients.forEach((entry) => { const ingredient = entry.ingredient; if(!ingredient) return; %>
  <article class="recipe">
    <% if(ingredient.image) { %>
    <img class="ingredient-photo" src="/uploads/<%= encodeURIComponent(ingredient.image) %>" alt="<%= ingredient.name %>" loading="lazy" />
    <% } %>
    <p class="eyebrow"><%= ingredient.isAlcohol ? 'Contains alcohol' : 'Alcohol free' %></p>
    <h3><%= ingredient.name %></h3>
    <p><%= ingredient.description %></p>
    <p><strong><%= entry.quantity %></strong></p>
    <div class="actions">
      <a href="/update/ingredient/<%= ingredient._id %>">Edit</a>
      <form
        method="post"
        action="/cocktails/<%= cocktail._id %>/ingredients/<%= ingredient._id %>/delete?csrf=<%= csrfToken %>"
        data-confirm="Remove this ingredient?"
      >
        <button class="danger" type="submit">
          Remove
          <span class="sr-only"><%= ingredient.name %></span>
        </button>
      </form>
    </div>
  </article>
  <% }) %>
</div>
<% if(!cocktail.ingredients.length) { %>
<p class="empty">This recipe has no ingredients.</p>
<% } %><%- include('layout/footer') %>
