<%- include('layout/header') %>
<div class="form-page">
  <a href="/">← Collection</a>
  <h1>Edit cocktail</h1>
  <form method="post" action="/cocktails/<%= cocktail._id %>/edit?csrf=<%= csrfToken %>">
    <label for="name">Name</label>
    <input id="name" name="name" maxlength="100" value="<%= cocktail.name %>" required />
    <label for="category">Category</label>
    <input id="category" name="category" maxlength="60" value="<%= cocktail.category %>" required />
    <label for="instruction">Instructions</label>
    <textarea id="instruction" name="instruction" maxlength="5000" required><%= cocktail.instruction %></textarea>
    <div class="actions">
      <button type="submit">Save changes</button>
      <a href="/">Cancel</a>
    </div>
  </form>
</div>
<%- include('layout/footer') %>
